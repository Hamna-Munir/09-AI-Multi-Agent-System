# --- LLM (Groq OpenAI-compatible endpoint, same pattern as earlier weeks) ---
OPENAI_API_KEY=gsk_your_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# --- Optional: external research for the Research Agent ---
# Without this, the Research Agent reports "external research unavailable"
# instead of failing silently or inventing sources.
TAVILY_API_KEY=
